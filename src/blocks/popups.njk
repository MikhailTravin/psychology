<div id="call" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <button type="button" data-close class="popup__close">
                <svg aria-hidden="true" width="8" height="8">
                    <use xlink:href="img/sprite.svg#close2"></use>
                </svg>
            </button>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="title2">
                        Запись через администратора
                    </div>
                </div>
                <form data-popup-message="#thanks" action="#" data-dev class="form">
                    <div class="form__body">
                        <div class="form__inputs">
                            <div class="form__input">
                                <label for="name" class="form__label">Ваше имя</label>
                                <input id="name" data-required autocomplete="off" type="text" name="name"
                                    placeholder="Иван" class="input">
                            </div>
                            <div class="form__input">
                                <label for="tel" class="form__label">Телефон</label>
                                <input id="tel" data-required autocomplete="off" type="text" name="phone"
                                    placeholder="+7 (__) ___-__-__" class="input telephone">
                            </div>
                        </div>
                        <div class="form__inputs">
                            <div class="form__label">Удобный способ связи</div>
                            <div class="options">
                                <label class="options__item">
                                    <input hidden checked class="options__input" type="radio" value="1" name="option1">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <img loading="lazy" src="img/icons/max.svg" alt="">
                                        </span>
                                        <span class="options__text">Max</span>
                                    </span>
                                </label>
                                <label class="options__item">
                                    <input hidden class="options__input" type="radio" value="2" name="option1">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <img loading="lazy" src="img/icons/tg2.svg" alt="">
                                        </span>
                                        <span class="options__text">Telegram</span>
                                    </span>
                                </label>
                                <label class="options__item">
                                    <input hidden class="options__input" type="radio" value="3" name="option1">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <img loading="lazy" src="img/icons/whatsapp.svg" alt="">
                                        </span>
                                        <span class="options__text">WhatsApp</span>
                                    </span>
                                </label>
                                <label class="options__item">
                                    <input hidden class="options__input" type="radio" value="4" name="option1">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <img loading="lazy" src="img/icons/phone1.svg" alt="">
                                        </span>
                                        <span class="options__text">Звонок</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <div class="form__inputs">
                            <div class="form__input">
                                <label for="comment" class="form__label">Комментарий</label>
                                <textarea id="comment"
                                    placeholder="Кратко опишите, что вас беспокоит или ваши пожелания"
                                    class="input textarea"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="form__bottom">
                        <button type="submit" class="btn btn-small">
                            <span>Отправить администратору</span>
                        </button>
                        <div class="form__text">
                            Мы свяжемся с вами в ближайшее время
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="8" height="8">
                    <use xlink:href="img/sprite.svg#close2"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="title2">Спасибо за заявку!</div>
                    <p>
                        Мы свяжемся с вами в ближайшее время
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>