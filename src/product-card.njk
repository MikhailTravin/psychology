<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-intro block-intro-other block-intro-bg">
                <div class="container">
                    <div class="block-intro__content">
                        <div class="breadcrumbs">
                            <ul>
                                <li>
                                    <a href="#">
                                        Главная
                                    </a>
                                </li>
                                <li>
                                    <a href="#">
                                        Специалисты
                                    </a>
                                </li>
                                <li><span>Анна Смирнова</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="block-product-card block2">
                <div class="container">
                    <div class="block-product-card__content">
